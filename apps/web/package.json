    "pinia": "3.0.4",
    "screenfull": "6.0.2",
    "vue": "3.5.42",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.1.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.1",
    "@types/nprogress": "0.2.3",
    "@types/path-browserify": "1.0.3",
    "@vitejs/plugin-vue": "6.0.7",
