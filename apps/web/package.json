    "eslint-plugin-format": "2.0.1",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "sass-embedded": "1.78.0",
    "typescript": "5.9.3",
    "unocss": "66.7.5",
