PROJECT_NAME="Campus Patrol API"
SECRET_KEY=GENERATE_SECRET_KEY
FIRST_SUPERUSER=operator@example.com
FIRST_SUPERUSER_PASSWORD=GENERATE_OPERATOR_PASSWORD
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional absolute overrides; defaults resolve from this repository, not the shell cwd.
# APP_DATA_DIR=/absolute/path/to/private/backend-data
# GO2_CONFIG=/absolute/path/to/config.local.json
# GO2_POINTS=/absolute/path/to/observation-points.local.json
# GO2_PYTHON=/absolute/path/to/python
# Real movement requires a separately confirmed operator setup. Default disabled.
MOTION_ENABLED=false
CAMERA_SOURCE=unitree
# CAPTURE_PYTHON=/absolute/path/to/camera/python
# DOCK_HOST=your-dock-host
# DOCK_USER=unitree
# DOCK_DEVICE=/dev/video4
TASK_TIMEOUT_SECONDS=90
# Extracted simulation: run edge/go2/simulation/setup.sh and prepare-assets first.
# SIM_PYTHON=/absolute/path/to/repository/edge/go2/simulation/.venv/bin/python
# SIM_SOURCE defaults to edge/go2/simulation/src; no old archive is required.
# Policies default to edge/go2/simulation/assets/{himloco,navigation}.pt.
# SIM_ROUTES defaults to edge/go2/simulation/routes.json (simulation-only).
SIM_SCENE=himloco_flat
SIM_STEPS=30000
SIM_RECORD_VIDEO=true
# Optional remote simulation demo; ordinary local execution remains the default.
# Prepare separate private configs with: bash cloud/backend/remote-demo.sh init
REMOTE_ENABLED=false
# REMOTE_EXECUTOR_KEY=generate-a-separate-random-key-at-least-32-characters
# REMOTE_SERVER_URL=https://your-task-server.example
# REMOTE_DEVICE_ID=ubuntu-simulation
# REMOTE_ROUTE_ID=checkpoints-simple
# REMOTE_DEMO_USER=judge@example.com
# REMOTE_DEMO_PASSWORD=generate-a-separate-random-password
# REMOTE_POLL_SECONDS=1
# REMOTE_OFFLINE_SECONDS=10
# REMOTE_DISPATCH_SECONDS=10
# REMOTE_MAX_VIDEO_BYTES=67108864
# EXECUTION_LOCK_PATH=/absolute/path/shared-by-local-api-and-executor.lock
# Complete HTTPS chat/completions endpoint, not the console/portal URL.
# HUAWEI_CHAT_COMPLETIONS_URL=https://your-model-endpoint/v1/chat/completions
# HUAWEI_MODEL=your-vision-model
# HUAWEI_API_KEY=fill-locally-only
HUAWEI_TIMEOUT_SECONDS=45
